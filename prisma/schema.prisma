datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  STAFF
}

enum BookingStatus {
  PENDING
  WAITING_PAYMENT
  PAID
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  phone         String?
  avatar        String?
  country       String?        @default("Indonesia")
  birthday      DateTime?
  role          String         @default("USER") // USER, ADMIN, STAFF
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  bookings      Booking[]
  reviews       Review[]
  wishlists     Wishlist[]
  notifications Notification[]
  sessions      Session[]
  accounts      Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Villa {
  id               String          @id @default(cuid())
  slug             String          @unique
  name             String
  tagline          String?
  description      String
  shortDescription String
  location         String          // e.g. "Uluwatu, Bali"
  destination      String          // Ubud, Seminyak, Canggu, Uluwatu, Nusa Dua, Sanur
  address          String
  latitude         Float           @default(-8.8300)
  longitude        Float           @default(115.1190)
  pricePerNight    Float
  cleaningFee      Float           @default(300000)
  serviceFeePercent Float          @default(5.0)
  taxPercent       Float           @default(11.0)
  bedrooms         Int             @default(3)
  bathrooms        Int             @default(3)
  maxGuests        Int             @default(6)
  sizeSqm          Int             @default(350)
  hasPrivatePool   Boolean         @default(true)
  villaType        String          @default("Luxury Cliffside Villa")
  rating           Float           @default(4.9)
  reviewCount      Int             @default(0)
  isFeatured       Boolean         @default(false)
  isActive         Boolean         @default(true)
  cancellationPolicy String        @default("Free cancellation up to 7 days before check-in. Non-refundable after that.")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  images           VillaImage[]
  rooms            Room[]
  facilities       VillaFacility[]
  bookings         Booking[]
  reviews          Review[]
  wishlists        Wishlist[]
  blockedDates     BlockedDate[]
}

model VillaImage {
  id          String   @id @default(cuid())
  villaId     String
  url         String
  caption     String?
  isThumbnail Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  villa Villa @relation(fields: [villaId], references: [id], onDelete: Cascade)
}

model Room {
  id            String   @id @default(cuid())
  villaId       String
  name          String
  description   String
  price         Float
  stock         Int      @default(1)
  guestCapacity Int      @default(2)
  bedType       String   @default("King Bed")
  facilities    String   @default("En-suite Bathroom, Ocean View, Smart TV, Air Conditioning")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  villa Villa @relation(fields: [villaId], references: [id], onDelete: Cascade)
}

model Facility {
  id        String          @id @default(cuid())
  name      String          @unique
  icon      String          // Lucide icon name
  category  String          @default("General") // General, Outdoor, Wellness, Service
  villas    VillaFacility[]
}

model VillaFacility {
  villaId    String
  facilityId String

  villa    Villa    @relation(fields: [villaId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([villaId, facilityId])
}

model Booking {
  id             String        @id @default(cuid())
  bookingCode    String        @unique // e.g. NV-2026-8921
  userId         String?
  villaId        String
  checkIn        DateTime
  checkOut       DateTime
  adults         Int           @default(1)
  children       Int           @default(0)
  infants        Int           @default(0)
  totalGuests    Int           @default(1)
  nightCount     Int           @default(1)
  villaPrice     Float
  cleaningFee    Float         @default(300000)
  serviceFee     Float         @default(0)
  taxAmount      Float         @default(0)
  discountAmount Float         @default(0)
  totalPrice     Float
  status         String        @default("WAITING_PAYMENT") // PENDING, WAITING_PAYMENT, PAID, CONFIRMED, CHECKED_IN, CHECKED_OUT, CANCELLED, REFUNDED
  
  guestName      String
  guestEmail     String
  guestPhone     String
  guestCountry   String        @default("Indonesia")
  specialRequests String?

  promoCode      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  villa          Villa         @relation(fields: [villaId], references: [id], onDelete: Cascade)
  payment        Payment?
  review         Review?
  guests         BookingGuest[]
}

model BookingGuest {
  id        String   @id @default(cuid())
  bookingId String
  fullName  String
  type      String   @default("ADULT") // ADULT, CHILD, INFANT

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String   @id @default(cuid())
  bookingId         String   @unique
  transactionId     String   @unique // Midtrans transaction id or mock id
  paymentMethod     String   // QRIS, BANK_TRANSFER, VIRTUAL_ACCOUNT, E_WALLET
  grossAmount       Float
  status            String   @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  snapToken         String?
  redirectUrl       String?
  vaNumber          String?
  billKey           String?
  billerCode        String?
  rawResponse       String?
  paidAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(cuid())
  villaId    String
  userId     String
  bookingId  String?  @unique
  rating     Float    @default(5.0)
  title      String?
  comment    String
  guestName  String
  guestCountry String @default("Indonesia")
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  villa      Villa    @relation(fields: [villaId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  villaId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  villa     Villa    @relation(fields: [villaId], references: [id], onDelete: Cascade)

  @@unique([userId, villaId])
}

model Promotion {
  id           String       @id @default(cuid())
  code         String       @unique
  description  String
  discountType String       @default("PERCENTAGE") // PERCENTAGE, FIXED_AMOUNT
  value        Float        // e.g. 20 for 20% or 500000 for Rp500.000
  minSpend     Float        @default(0)
  maxDiscount  Float?
  startDate    DateTime     @default(now())
  endDate      DateTime
  usageLimit   Int          @default(100)
  usageCount   Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  usages       PromotionUsage[]
}

model PromotionUsage {
  id          String    @id @default(cuid())
  promotionId String
  userId      String?
  bookingCode String
  usedAt      DateTime  @default(now())

  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // BOOKING, PAYMENT, PROMO, SYSTEM
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BlockedDate {
  id        String   @id @default(cuid())
  villaId   String
  startDate DateTime
  endDate   DateTime
  reason    String   @default("Maintenance")
  createdAt DateTime @default(now())

  villa     Villa    @relation(fields: [villaId], references: [id], onDelete: Cascade)
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
